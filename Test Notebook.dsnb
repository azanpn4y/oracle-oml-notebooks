          "FOR i IN 1..100 LOOP",
          "INSERT INTO small_table VALUES ('Name_'||i, i,'ID2_'||i,'ID3_'||i,'ID4_'||i,'TEXT_'||i);",
          "END LOOP;",
          "COMMIT;",
          "END;"
